  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "qwen",
    "dashscope",
    "bailian",
    "aliyun",
    "alibaba-cloud",
    "coupon",
    "voucher",
    "bss",
    "billing",
    "cost",
    "balance"
  ],
  "homepage": "https://github.com/KAIXIN2006/dsh-qwen-coupon-balance#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KAIXIN2006/dsh-qwen-coupon-balance.git"
  },
  "bugs": {
    "url": "https://github.com/KAIXIN2006/dsh-qwen-coupon-balance/issues"
  },
  "author": "KAIXIN2006",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
